{
  "manifest_version": 3,
  "name": "YouTube Just Jump",
  "version": "1.1",
  "description": "Press Alt+J to skip promotions in the YouTube player.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "jump-ahead-command": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Alt+J"
      },
      "description": "Skips the current YouTube promotion"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}